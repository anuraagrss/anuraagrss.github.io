rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function hasRole(role) {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == role;
    }

    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // admins — each user can read their own doc; only super-admin can write
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if hasRole('super-admin');
    }

    // Chinni's rewards — rewards or super-admin
    match /sarah_achievements/{docId} {
      allow read, write: if hasRole('rewards') || hasRole('super-admin');
    }

    // Public read — photos, flights, countries (public portfolio pages)
    match /photos/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /flights/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /countries/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /cafes/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /experiences/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Proofs — strangers answer "what's the proof you're still alive?" at the bench.
    // Anyone can leave one (short, plain text, waiting for me to read it); only the ones
    // I've marked approved are readable. Nobody but an admin can edit or delete.
    match /proofs/{docId} {
      allow create: if request.resource.data.keys().hasOnly(['text', 'page', 'approved', 'createdAt'])
                    && request.resource.data.text is string
                    && request.resource.data.text.size() > 0
                    && request.resource.data.text.size() <= 280
                    && request.resource.data.page in ['journey', 'journal']
                    && request.resource.data.approved == false
                    && request.resource.data.createdAt == request.time;
      allow read: if resource.data.approved == true || isAdmin();
      allow update, delete: if isAdmin();
    }

    // Everything else — any authenticated admin
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
